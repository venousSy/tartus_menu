# Copy this file to .env and fill in real values. Never commit .env.

# Login rate limit per client IP (UC-AUTH-001). Format: <number>/<sec|min|hour|day>
LOGIN_THROTTLE_RATE=5/min
# Trusted proxies in front of Django. Development (no proxy): 0. Production (Nginx): 1.
DJANGO_NUM_PROXIES=0

# Public menu revalidation (system_design.md section 3.5). Empty URL = disabled (no frontend yet).
# Docker example: http://frontend:3000/internal/revalidate. Use a long random secret shared with Next.js.
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
