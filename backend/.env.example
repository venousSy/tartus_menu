# Copy this file to .env and fill in real values. Never commit .env.

# Django core. DJANGO_DEBUG=True only for local development; production must be False (the default).
DJANGO_DEBUG=False
# A long random string, required when DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=
# Comma-separated host names, required when DJANGO_DEBUG=False, e.g. menu.domain.com,backend
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins allowed by CORS when DJANGO_DEBUG=False (all are allowed in development).
# May stay empty when Nginx serves the frontend and /api/ on the same domain.
CORS_ALLOWED_ORIGINS=

# PostgreSQL 16.
DB_NAME=tartus_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Login rate limit per client IP (UC-AUTH-001). Format: <number>/<sec|min|hour|day>
LOGIN_THROTTLE_RATE=5/min
# Trusted proxies in front of Django. Development (no proxy): 0. Production (Nginx): 1.
DJANGO_NUM_PROXIES=0

# Public menu revalidation (system_design.md section 3.5). Empty URL = disabled: owner changes then reach
# the public menu only through Next.js's 5-minute fallback. Development: http://127.0.0.1:3000/internal/revalidate
# Docker: http://frontend:3000/internal/revalidate. Use a long random secret shared with Next.js.
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=

# Public menu address printed in the QR codes (UC-OWNER-007), without a trailing slash.
# Production: https://menu.domain.com. Empty with DJANGO_DEBUG=True: http://localhost:3000.
PUBLIC_MENU_BASE_URL=

# Django admin site path, without slashes. Production: a long random word (not "admin"); Nginx routes it.
# Empty with DJANGO_DEBUG=True: admin.
DJANGO_ADMIN_PATH=

# Cloudflare R2 for uploaded images (UC-OWNER-006, UC-OWNER-010). USE_S3=False saves them under backend/media/.
USE_S3=False
# Only with USE_S3=False: the absolute address of backend/media/, served by Django when DJANGO_DEBUG=True.
# Empty = http://127.0.0.1:8000/media/ (the runserver address). Ends with a slash.
DJANGO_MEDIA_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3 API endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Public custom domain of the bucket, without https:// (e.g. media.domain.com). Required when USE_S3=True.
R2_CUSTOM_DOMAIN=

# Daily database backup (python manage.py backup_database). A separate PRIVATE bucket (no public domain)
# with its own API token that can access only that bucket. Not needed for local development.
R2_BACKUP_BUCKET_NAME=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Optional: S3 API endpoint of the backup bucket. Empty = the same as R2_ENDPOINT_URL.
R2_BACKUP_ENDPOINT_URL=
