# Production settings for Docker Compose (compose.yaml). Copy this file to .env on the server and fill
# in every value. Never commit .env. For local development without Docker, use backend/.env and
# frontend/.env.local instead.

# Public host name of the site, without https://, e.g. menu.domain.com.
DOMAIN=

# Version of the backend and frontend images to run: a commit SHA, or "latest" (the default when empty).
# The CI deploy sets it for each run; set it here only to pin a version by hand (for example a rollback).
IMAGE_TAG=

# Django. A long random string (for example: python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=
# Django admin site path, without slashes: a long random word, never "admin".
DJANGO_ADMIN_PATH=
# Login rate limit per client IP (UC-AUTH-001). Format: <number>/<sec|min|hour|day>
LOGIN_THROTTLE_RATE=5/min

# PostgreSQL 16. The db service creates this database and user on its first start.
DB_NAME=tartus_db
DB_USER=postgres
DB_PASSWORD=

# Shared by Django and Next.js for the public menu revalidation (system_design.md §3.5). A long random string.
FRONTEND_REVALIDATE_SECRET=

# Cloudflare R2 for uploaded images (UC-OWNER-006, UC-OWNER-010).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3 API endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Public custom domain of the bucket, without https:// (e.g. media.domain.com).
R2_CUSTOM_DOMAIN=

# Daily database backup (backup service). A SEPARATE private R2 bucket (no public domain) and an API token
# that can access only that bucket. Dumps are saved encrypted as backups/YYYY-MM-DD.sql.gz.age.
R2_BACKUP_BUCKET_NAME=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Optional: S3 API endpoint of the backup bucket. Empty = the same as R2_ENDPOINT_URL.
R2_BACKUP_ENDPOINT_URL=
# The age PUBLIC key ("age1...") the dumps are encrypted for (deploy/README.md §12.1). Never put the
# private key (AGE-SECRET-KEY-...) on the server: only its owner can then read a dump.
BACKUP_AGE_PUBLIC_KEY=

# Optional password reset email (UC-AUTH-006, deploy/README.md §15), over SMTP with STARTTLS. Empty EMAIL_HOST =
# no email: "Forgot password?" then tells the owner to contact support, and you send a link from the admin page.
# Resend: EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=<API key>.
EMAIL_HOST=
# Empty = 587.
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# The sender, required with EMAIL_HOST, e.g. Tartus Menu <no-reply@menu.domain.com>
DEFAULT_FROM_EMAIL=

# Optional error tracking (deploy/README.md §14): the DSN of a Sentry or GlitchTip project, used by Django and
# Next.js. Empty = no error reports are sent. Each report names the image version (IMAGE_TAG) as its release.
SENTRY_DSN=
