# Copy to .env.local for development. Never commit real values.

# Base URL of the Django API as the Next.js server sees it, with the /api/v1 prefix and no trailing slash.
# Development: http://127.0.0.1:8000/api/v1   Docker Compose: http://backend:8000/api/v1
DJANGO_API_URL=http://127.0.0.1:8000/api/v1

# The same value as Django's FRONTEND_REVALIDATE_SECRET (system_design.md §3.5): Django sends it to
# POST /internal/revalidate after every menu change. Empty = every call is refused.
FRONTEND_REVALIDATE_SECRET=
