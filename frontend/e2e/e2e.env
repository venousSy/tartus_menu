# Values for the end-to-end test stack (frontend/e2e/compose.e2e.yaml). They are NOT secrets: the stack
# listens on 127.0.0.1 only and is deleted after every run. Never use any of these values on a server.

DOMAIN=localhost
# Local builds are tagged "e2e", so they never replace a "latest" image pulled from the registry.
IMAGE_TAG=e2e

DJANGO_SECRET_KEY=e2e-only-not-a-secret-0123456789-abcdefghijklmnopqrstuvwxyz
DJANGO_ADMIN_PATH=e2e-admin
# Several logins run within one minute; the real limit (5/min) is covered by the backend tests.
LOGIN_THROTTLE_RATE=60/min

DB_NAME=tartus_e2e
DB_USER=postgres
DB_PASSWORD=e2e-db-password

FRONTEND_REVALIDATE_SECRET=e2e-revalidate-secret

# Required by compose.yaml but never used: the tests upload no images and run no backup.
R2_ACCESS_KEY_ID=unused
R2_SECRET_ACCESS_KEY=unused
R2_BUCKET_NAME=unused
R2_ENDPOINT_URL=http://r2.invalid
R2_CUSTOM_DOMAIN=media.invalid
R2_BACKUP_BUCKET_NAME=unused
R2_BACKUP_ACCESS_KEY_ID=unused
R2_BACKUP_SECRET_ACCESS_KEY=unused
BACKUP_AGE_PUBLIC_KEY=unused
