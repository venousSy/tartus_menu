# Nginx in front of the whole site (system_design.md §5, "Nginx Rules").
# This is a template: when the container starts, the nginx image replaces ${DOMAIN} and ${DJANGO_ADMIN_PATH}
# with their environment values and writes the result to /etc/nginx/conf.d/default.conf.
# Nginx's own variables ($host, $remote_addr, ...) are not environment variables, so they stay unchanged.

# Login rate limit per client IP: a coarse outer layer. The exact rule (5/min) is DRF's login throttle.
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_status 429;

# Public menu pages per client IP (system_design.md §3.4: Django does not throttle the public menu API).
# Generous, because all customers of one cafe may share one IP behind its Wi-Fi: the burst lets a full
# cafe scan its QR codes at once, the steady rate stops one address from flooding Django with unknown slugs.
limit_req_zone $binary_remote_addr zone=menu:10m rate=2r/s;

# The menu open counter (UC-GUEST-004): every call is one database write, and anyone may call it.
# One open per second per address on average; the burst lets a full cafe behind one Wi-Fi address open
# its menus at once. A script cannot inflate a cafe's numbers faster than that.
limit_req_zone $binary_remote_addr zone=views:10m rate=1r/s;

# Do not tell the internet which Nginx version runs here.
server_tokens off;

# Port 80: certificate renewals and a redirect to HTTPS, nothing else.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt checks a file that Certbot (on the host) writes here when it renews the certificate.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Uploads are at most 2 MB (checked by Django); bigger bodies are refused here with 413.
    client_max_body_size 3m;

    # Browsers remember for one year to use HTTPS only. A location with its own add_header
    # loses this one, so /menu/ repeats it.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Sent to Django and Next.js on every proxied request (system_design.md §3.6).
    # $http_host keeps the port, so the BFF Origin check also works on a non-default port.
    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Look up "backend" and "frontend" in Docker's DNS at request time (cached 10 s), not only at start:
    # when a deploy recreates a container with a new address, Nginx follows it instead of answering 502.
    # proxy_pass with a variable and no path sends the request path unchanged.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend  http://backend:8000;
    set $frontend http://frontend:3000;

    # Django API.
    location /api/ {
        proxy_pass $backend;
    }

    location = /api/v1/auth/login/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $backend;
    }

    # Tries of a password reset link (UC-AUTH-005): the same coarse outer limit as the login.
    location = /api/v1/auth/password-reset/confirm/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $backend;
    }

    # Requests for a password reset email (UC-AUTH-006): the same outer limit. Django allows 5 per hour.
    location = /api/v1/auth/password-reset/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $backend;
    }

    # The public menu API is open to the internet too, and Django does not throttle it. Next.js calls
    # Django on the Docker network, not through here, so only direct callers share this budget.
    location /api/v1/menu/ {
        limit_req zone=menu burst=100 nodelay;
        proxy_pass $backend;
    }

    # The menu open counter, called directly (UC-GUEST-004). A regex location wins over the prefix
    # location /api/v1/menu/ above, so these calls use the "views" budget, not the menu's.
    location ~ ^/api/v1/menu/[^/]+/views/$ {
        limit_req zone=views burst=50 nodelay;
        proxy_pass $backend;
    }

    # The QR link lookup (UC-GUEST-003) is public too; Next.js calls it on the Docker network.
    location /api/v1/qr/ {
        limit_req zone=menu burst=100 nodelay;
        proxy_pass $backend;
    }

    # Django admin site at its non-obvious path.
    location /${DJANGO_ADMIN_PATH}/ {
        proxy_pass $backend;
    }

    location = /${DJANGO_ADMIN_PATH}/login/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $backend;
    }

    # The Django admin's CSS and JS, collected by the backend into the shared "static" volume.
    location /static/ {
        alias /var/www/static/;
        expires 7d;
    }

    # Django -> Next.js revalidation is for the Docker network only (system_design.md §3.5).
    location /internal/ {
        return 404;
    }

    # Health check for the uptime monitor (system_design.md §3.7): Nginx -> Next.js -> Django -> PostgreSQL.
    # Checked every minute or so, so it stays out of the access log; the menu budget stops a flood.
    location = /health {
        access_log off;
        limit_req zone=menu burst=20 nodelay;
        proxy_pass $frontend;
    }

    # Next.js: BFF login route, customer menu, dashboards.
    location = /bff/auth/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $frontend;
    }

    # The BFF route behind the reset page (UC-AUTH-005).
    location = /bff/auth/password-reset {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $frontend;
    }

    # The BFF route behind the "Forgot password?" page (UC-AUTH-006).
    location = /bff/auth/forgot-password {
        limit_req zone=login burst=5 nodelay;
        proxy_pass $frontend;
    }

    # The short links printed in the QR codes (/t/<qr_token>, UC-GUEST-003): Next.js redirects them to the
    # menu. Same budget as the menu, since a full cafe may scan at once. The route sets X-Robots-Tag itself.
    location /t/ {
        limit_req zone=menu burst=100 nodelay;
        proxy_pass $frontend;
    }

    # The same counter as the menu page calls it: Next.js passes the call to Django (UC-GUEST-004).
    location ~ ^/menu/[^/]+/views$ {
        limit_req zone=views burst=50 nodelay;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        proxy_pass $frontend;
    }

    location /menu/ {
        limit_req zone=menu burst=100 nodelay;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        proxy_pass $frontend;
    }

    location / {
        proxy_pass $frontend;
    }
}
